# Copy to .env and fill in values. Do not commit .env.

# Azure SSO (production)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# Must match Azure app registration "Redirect URI" exactly (use your Railway URL or custom domain).
# Example: https://your-service.up.railway.app/auth/callback
# AZURE_REDIRECT_URI=

ALLOWED_EMAIL_DOMAIN=cybersmithsecure.com
SESSION_SECRET_KEY=change-me-in-production
SESSION_TIMEOUT=2700
CSRF_TIMEOUT=2700
TRUSTED_PROXY_HOSTS=*

# OpenAI (required for AI Layer)
OPENAI_API_KEY=sk-proj-replace-with-your-secret-key
OPENAI_MODEL=gpt-4o

# Local dev only; must be false in production (Railway + real SSO)
TEST_MODE=true

# Railway / reverse proxy settings
# SESSION_SECRET_KEY=<long random string>
# TRUSTED_PROXY_HOSTS=*

# Database: SQLite lives at Automation/backend/data.db
# On Railway, use persistent storage volume or external database
