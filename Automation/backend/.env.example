# Copy to .env and fill in values. Do not commit .env.

# Azure SSO (production)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# Must match Azure app registration "Redirect URI" exactly (use your Railway URL or custom domain).
# Example: https://your-service.up.railway.app/auth/callback
# If unset on Railway, auth.py falls back to https://<RAILWAY_PUBLIC_DOMAIN>/auth/callback when Railway sets that variable.
# AZURE_REDIRECT_URI=

ALLOWED_EMAIL_DOMAIN=cybersmithsecure.com
SESSION_SECRET_KEY=change-me-in-production
SESSION_TIMEOUT=2700
CSRF_TIMEOUT=2700
TRUSTED_PROXY_HOSTS=*

# Type6 closure: optional override for base .docx or .pdf. Default: Automation/backend/
# "AdvantageGo Exact Web app VAPT Technical Closure Report 1.docx", then
# AdvantageGo_Closure_Base_Template.docx, then the AdvantageGo PDF in Downloads (cached).
# TYPE6_CLOSURE_BASE_TEMPLATE=C:\\path\\to\\my_base.docx

# OpenAI (required for AI Layer)
OPENAI_API_KEY=sk-proj-replace-with-your-secret-key
OPENAI_MODEL=gpt-4o

# Optional: only if your OpenAI account requires explicit org/project scoping
# OPENAI_ORGANIZATION=org-xxxxxxxx
# OPENAI_PROJECT=proj_xxxxxxxx

# Executive Summary Word template: Automation/backend/exec_summary_template.docx (run build_exec_template.py after updating assets/)
# Executive Summary (/exec-summary): prefers a dedicated key; if unset, uses OPENAI_API_KEY above.
# EXEC_SUMMARY_OPENAI_API_KEY=sk-proj-replace-with-exec-summary-key
# OPENAI_EXEC_SUMMARY_API_KEY=sk-proj-alternate-name-same-purpose
# Optional overrides (else uses OPENAI_MODEL / OPENAI_ORGANIZATION / OPENAI_PROJECT)
# EXEC_SUMMARY_OPENAI_MODEL=gpt-4o
# EXEC_SUMMARY_OPENAI_ORGANIZATION=org-xxxxxxxx
# EXEC_SUMMARY_OPENAI_PROJECT=proj_xxxxxxxx

# Local dev only; must be false in production (Railway + real SSO)
TEST_MODE=true

# Railway / reverse proxy: HTTPS cookies and correct client IP (defaults are safe for Railway)
# TEST_MODE=false
# SESSION_SECRET_KEY=<long random string>
# TRUSTED_PROXY_HOSTS=*

# SQLite lives at Automation/backend/data.db — on Railway the filesystem is ephemeral unless you attach a volume;
# audit logs / Cert-IN DB rows can be lost on redeploy unless you persist storage or use an external DB.

# --- Production (Railway) checklist ---
# TEST_MODE=false
# SESSION_SECRET_KEY=<long random string; not change-me or supersecret>
# OPENAI_API_KEY=<secret>   OR   EXEC_SUMMARY_OPENAI_API_KEY=<secret>
# TRUSTED_PROXY_HOSTS=*   (behind Railway reverse proxy)
# Azure SSO: AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID, AZURE_REDIRECT_URI=https://<your-host>/auth/callback
# Executive Summary requires SSO: /exec-summary is protected; open from Report Formats after login.
# Ensure Automation/backend/exec_summary_template.docx is in the deployed repo (not gitignored).
