# Copy to .env and fill in values. Do not commit .env.

# Azure SSO (production)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_REDIRECT_URI=

ALLOWED_EMAIL_DOMAIN=cybersmithsecure.com
SESSION_SECRET_KEY=change-me-in-production

# OpenAI (required for AI Layer)
OPENAI_API_KEY=sk-proj-replace-with-your-secret-key
OPENAI_MODEL=gpt-4o

# Optional: only if your OpenAI account requires explicit org/project scoping
# OPENAI_ORGANIZATION=org-xxxxxxxx
# OPENAI_PROJECT=proj_xxxxxxxx

# Local dev only; must be false in production
TEST_MODE=true
