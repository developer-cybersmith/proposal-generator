# Copy to Automation/backend/.env and fill in values. Never commit .env.

# --- AI annexures (required for "Other / Custom Service" and for types with no template annexure) ---
# Key used ONLY for the proposal's custom annexures. Leave empty to fall back to OPENAI_API_KEY.
PROPOSAL_OPENAI_API_KEY=
# Optional model override for the custom annexures (falls back to OPENAI_MODEL, then gpt-4o)
# PROPOSAL_OPENAI_MODEL=gpt-4o
# Shared key/model (also used if the two lines above are empty)
OPENAI_API_KEY=sk-proj-replace-with-your-secret-key
OPENAI_MODEL=gpt-4o

# --- Access control ---
# Shared password for the /login page
PROPOSAL_ACCESS_PASSWORD=choose-a-strong-password
# Optional: lets scripts call the API with header  X-API-Key: <value>
# PROPOSAL_API_KEY=
SESSION_SECRET_KEY=change-me-in-production
SESSION_TIMEOUT=2700
TRUSTED_PROXY_HOSTS=*

# --- Rate limits per client IP, "<calls>/<seconds>" (process-local; with N gunicorn workers the effective limit is N x) ---
# RATE_LIMIT_UPLOAD=10/60        Excel uploads
# RATE_LIMIT_GENERATE=5/60       proposal generation (manual and Excel flows; AI calls cost money)
# RATE_LIMIT_DISABLED=1          tests / local development only

# --- PDF proof, blank-page check and measured Contents page numbers ---
# auto (default) = LibreOffice if `soffice` is installed (Railway), otherwise Microsoft Word on a Windows PC that has it
# libreoffice | word | off (off = no preview and no layout check; the Word file is still produced)
# PROPOSAL_PDF_ENGINE=auto
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# --- Local dev only (must be false/unset in production) ---
# TEST_MODE=true      -> allows the session cookie over plain http
# AUTH_DISABLED=true  -> skips login entirely
