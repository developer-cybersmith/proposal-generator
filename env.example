# AWS RDS PostgreSQL Configuration
AWS_RDS_HOST=your-rds-endpoint.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DATABASE=vapt_reports
AWS_RDS_USER=vaptadmin
AWS_RDS_PASSWORD=your-secure-password

# AWS S3 Configuration
S3_REPORTS_BUCKET=vapt-reports-yourcompany
S3_EXCEL_BUCKET=vapt-excel-files-yourcompany
S3_IMAGES_BUCKET=vapt-images-yourcompany
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1

# Application Configuration
DATABASE_URL=postgresql://vaptadmin:password@your-rds-endpoint.amazonaws.com:5432/vapt_reports

# Security Configuration
SECRET_KEY=your-secret-key-for-sessions
# Strong random value; must stay stable across deploys or all users are logged out.
SESSION_SECRET_KEY=change-me-use-openssl-rand-hex-32
# Session idle timeout (seconds). Each authenticated request refreshes the timer (sliding) in production (TEST_MODE=false).
# 2700 = 45 minutes (recommended production default in app.py).
SESSION_TIMEOUT=2700
# CSRF token validity (seconds). Should be >= SESSION_TIMEOUT so long forms do not fail mid-session.
CSRF_TIMEOUT=2700
# Local dev: bypass session/CSRF middleware for /type1-/type5 (not for production).
TEST_MODE=false
# Comma-separated IPs or use * so X-Forwarded-Proto is trusted behind Railway / nginx (required for Secure cookies).
TRUSTED_PROXY_HOSTS=*

# Railway / reverse proxy
# Set TEST_MODE=false, SESSION_SECRET_KEY, DATABASE_URL, Azure OAuth vars, and TRUSTED_PROXY_HOSTS=* in the Railway dashboard.
# The app uses uvicorn ProxyHeadersMiddleware so HTTPS and Secure session cookies work behind Railway's proxy.

# Analytics Configuration
ENABLE_ANALYTICS=true
TRACK_USER_ACTIONS=true
TRACK_FILE_SIZES=true
TRACK_PROCESSING_TIMES=true

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password